{
  "_meta": {
    "type": "mekanism:reaction",
    "source": "bundled",
    "mod_version_target": "1.21.x",
    "engine_version": "1.0",
    "_note": "Pressurized Reaction Chamber. At least one of item_output or chemical_output must be present."
  },
  "fields": {
