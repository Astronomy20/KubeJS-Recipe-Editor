    "fluid_output": { "descriptor": "IngredientField", "optional": true, "acceptedTypes": ["FLUID"], "subfields": { "amount": { "descriptor": "ScalarField", "scalarType": "INTEGER", "optional": false, "defaultValue": "1000", "min": 1, "max": 10000000 } } }
