{
  "_meta": {
    "type": "extendedcrafting:shaped_table",
    "source": "bundled",
    "mod_version_target": "1.21 branch (BlakeBr0/ExtendedCrafting)",
    "engine_version": "1.0",
    "_note": "pattern uses ShapedRecipePattern codec (rows array + key map). tier 0 = auto-select smallest table that fits."
  },
  "fields": {
    "type": {
      "descriptor": "ConstantField",
      "constantValue": "extendedcrafting:shaped_table"
    },
    "pattern": {
      "descriptor": "ArrayField",
      "optional": false,
      "minItems": 1,
      "maxItems": 9,
      "elementDescriptor": {
        "descriptor": "ScalarField",
        "scalarType": "FREE_STRING",
        "optional": false
      }
    },
    "key": {
      "descriptor": "ObjectField",
      "optional": false,
      "collapsible": true,
      "children": {
        "*": {
          "descriptor": "IngredientField",
          "optional": false,
          "acceptedTypes": ["ITEM", "ITEM_TAG"]
        }
      }
    },
    "result": {
      "descriptor": "IngredientField",
      "optional": false,
      "acceptedTypes": ["ITEM"],
      "subfields": {
        "count": {
          "descriptor": "ScalarField",
          "scalarType": "INTEGER",
          "optional": true,
          "defaultValue": "1",
          "min": 1
        }
      }
    },
    "tier": {
      "descriptor": "ScalarField",
      "scalarType": "INTEGER",
      "optional": true,
      "defaultValue": "0",
      "min": 0,
      "max": 4,
      "enumValues": ["0", "1", "2", "3", "4"]
    }
  }
}
